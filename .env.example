# =============================================================================
# Neem — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
#
# The API validates this file with zod at boot. In production it REFUSES TO
# START if a required credential is missing, rather than silently degrading.
# In development, an absent provider credential selects the mock adapter and
# logs a prominent warning (spec §7, §77, §93).
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# The Lovable vite config pins the dev server to 8080 (it does its own port
# and strictPort handling). WEB_ORIGIN must match, or the API rejects the web
# app on CORS — the session travels as a cookie, so the origin must be exact.
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

# The public marketing site (the neem-site repository), which is a different
# origin from the app and calls exactly one endpoint: POST /pilot-applications.
#
# Leave it blank and that origin is simply not on the CORS allow-list, so the
# browser blocks the pilot form. That is the safe way round: an unset value
# denies rather than permits. Set it to the marketing site's origin — with no
# trailing slash — in every environment where the form should work.
MARKETING_ORIGIN=http://localhost:5183

API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Must match docker/docker-compose.yml. Host port defaults to 3307 so it does
# not collide with a native MySQL already listening on 3306.
MYSQL_PORT=3307
MYSQL_DATABASE=neem
MYSQL_USER=neem
MYSQL_PASSWORD=neem_dev
MYSQL_ROOT_PASSWORD=neem_root_dev

DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem"
TEST_DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem_test"

# Prisma Migrate uses a throwaway shadow database to detect schema drift.
# Provided explicitly so the application user needs no CREATE DATABASE right.
SHADOW_DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem_shadow"

# Least-privilege append-only account for the audit log (docs/security.md §7).
AUDIT_DATABASE_URL="mysql://neem_audit:neem_audit_dev@localhost:3307/neem"

# --- Secrets ----------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The development placeholders below are NOT usable in production; the config
# loader rejects them when NODE_ENV=production.
SESSION_SECRET=dev-only-change-me-session-secret-value-0000000000
CSRF_SECRET=dev-only-change-me-csrf-secret-value-00000000000000

# AES-256-GCM key for encrypting patient name/phone, doctor signatures,
# pharmacy payout details and TOTP secrets at rest. 32 bytes, base64url.
ENCRYPTION_KEY=dev-only-change-me-encryption-key-000000000000

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
PATIENT_SESSION_TIMEOUT_MINUTES=60

# --- Authentication hardening ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX_PER_MINUTE=120

# Stricter per-IP cap on login, 2FA and password-reset endpoints. Distinct from
# LOGIN_MAX_ATTEMPTS, which locks one account; this caps one source across many.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW="15 minutes"
RATE_LIMIT_ONBOARDING_MAX=5
RATE_LIMIT_ONBOARDING_WINDOW="1 hour"

# The public pilot form on the marketing site. Looser than account creation,
# because a whole pharmacy can sit behind one address and the second colleague
# to fill the form in must not be turned away; tighter than the global default,
# because it is an open write endpoint.
RATE_LIMIT_PILOT_MAX=20
RATE_LIMIT_PILOT_WINDOW=1 hour

# --- Running the end-to-end suite -------------------------------------------
# The values above are production-shaped, and the end-to-end suite cannot run
# against them: it signs in as several roles dozens of times from one address,
# and is refused with 429 part-way through. Every test after that fails for a
# reason that has nothing to do with what it was testing.
#
# So raise them for a machine that runs the suite. Uncomment these four,
# replacing the values above:
#
#   RATE_LIMIT_MAX_PER_MINUTE=5000
#   RATE_LIMIT_AUTH_MAX=500
#   RATE_LIMIT_ONBOARDING_MAX=500
#   # Placing a Call Me bridge. Each one costs money and occupies one of a small
# number of subscribed simultaneous lines, so this is an operational dial, not
# only an abuse control.
RATE_LIMIT_CALL_MAX=10
RATE_LIMIT_CALL_WINDOW="5 minutes"

RATE_LIMIT_QR_EXCHANGE_MAX=500
#
# They are commented rather than shipped because this file is also the template
# a deployment starts from, and a login endpoint permitting 500 attempts per IP
# is the single most plausible way this repository ends up with an open front
# door. Booting with NODE_ENV=production refuses these values outright, so the
# mistake is caught rather than trusted to a comment — but the safe number is
# the one that ships.

# --- Providers --------------------------------------------------------------
# Each accepts: mock | <real provider>. Leave as mock until credentials exist.
# Mock mode is labelled in the UI and stamped on every log line — the system
# never claims a payment, call or message happened when it cannot verify it.
PAYMENT_PROVIDER=mock
# mock | whereby  — whereby carries real video and audio (decision D18).
VIDEO_PROVIDER=mock
# none | mock. "Call Me" is OFF by default (D38).
#
# It dials both parties and bridges them so neither learns the other's number
# (spec §33). Whereby is browser-to-browser and cannot; no Ghanaian provider
# checked so far publishes call bridging (D36, D37). Deferred to the pilot.
#
# `none` and `mock` are different states. A mock PRETENDS — it reports a call
# that never happened, which is why production refuses it. `none` does not:
# the mode is not offered to patients, the routes refuse it, and nothing
# claims a call took place. Production accepts `none`.
VOICE_PROVIDER=none
# mock | arkesel | hubtel
SMS_PROVIDER=mock
EMAIL_PROVIDER=mailhog
# No provider. Unused.
WHATSAPP_PROVIDER=mock

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Paystack signs webhooks with the SECRET key. PAYSTACK_WEBHOOK_SECRET exists
# only to separate the two in a test harness; leave it unset in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# How long to wait on Paystack before treating a call as failed. A payment
# left in doubt is worse than one reported failed, so this is deliberately
# short enough that a hung provider does not hold the counter.
PAYSTACK_TIMEOUT_MS=15000

# Printed on receipts. Not a URL the application calls.
PAYSTACK_RECEIPT_DOMAIN=receipts.neem.local

# --- Whereby Embedded (video and in-browser audio) --------------------------
# One credential: a Bearer API key from the Whereby dashboard, under
# Configure -> API keys. There is no second secret and no webhook signing key —
# this adapter receives no webhooks, because Neem's own state machine decides
# when a consultation is over, not the video provider.
#
# Required when VIDEO_PROVIDER=whereby; the API refuses to boot without it.
#
# RECORDING MUST BE OFF AT THE ACCOUNT LEVEL. The adapter never asks Whereby to
# record and has no method that could, but Whereby's dashboard can enable
# recording independently of anything in this repository. Consultations are
# never recorded (spec §32), and that guarantee is only as good as the account
# setting. See docs/security.md.
WHEREBY_API_KEY=
WHEREBY_TIMEOUT_MS=15000

# --- Arkesel SMS (the configured provider) -----------------------------------
# From the Arkesel dashboard under API keys. Required when SMS_PROVIDER=arkesel.
#
# ARKESEL_SENDER_ID is the name a recipient sees — alphanumeric, at most 11
# characters. It MUST BE REGISTERED with the Ghanaian networks. An unregistered
# sender is accepted by the API and then dropped by the network, silently, so
# the failure looks like a working integration that delivers nothing.
#
# Verify with a real message before trusting it:
#   npm run arkesel:check -- --to 0244123456
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Neem
ARKESEL_TIMEOUT_MS=15000

# --- Hubtel SMS (built, not in use) ------------------------------------------
# From the Hubtel dashboard under API keys. Required when SMS_PROVIDER=hubtel.
#
# HUBTEL_SENDER_ID is the name a recipient sees — alphanumeric, at most 11
# characters. It MUST BE REGISTERED with the Ghanaian networks. An unregistered
# sender is accepted by the API and then dropped by the network, silently, so
# the failure looks like a working integration that delivers nothing. MTN began
# blocking unregistered senders in July 2026.
#
# Verify with a real message before trusting it:
#   npm run hubtel:check -- --to 0244123456
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Neem
HUBTEL_TIMEOUT_MS=15000

# SMTP (MailHog by default in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Neem <no-reply@neem.local>"

# SMS / WhatsApp — no provider selected (spec §57). These placeholders are read
# by nothing: they predate the adapter interfaces and are kept only so the
# shape of what a provider needs is visible. Whatever is chosen brings its own
# variables, and its own boot-time guard that the sender is configured.
SMS_API_KEY=
SMS_SENDER_ID=Neem
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- File storage -----------------------------------------------------------
# Local disk in development; swap for object storage in the cloud without
# touching business logic. Stored OUTSIDE the web root, served only through an
# authorised, audited endpoint.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./apps/api/uploads
UPLOAD_MAX_BYTES=10485760

# --- Demo data --------------------------------------------------------------
# Seeds demo pharmacies, doctors, consultations and analytics, all flagged
# isDemo=true. MUST be false in production (spec §76).
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@neem.demo
DEMO_ADMIN_PASSWORD=NeemDemoAdmin!2026
# QR token exchange, per IP. A pharmacy shares one public IP, so this allows a
# real queue of patients while still stopping a script guessing tokens.
RATE_LIMIT_QR_EXCHANGE_MAX=20
RATE_LIMIT_QR_EXCHANGE_WINDOW="5 minutes"

# Retired encryption keys, comma-separated. Decrypt-only, never used to encrypt.
# Clinical records are retained for years (decision D23), so the key that wrote
# them outlives its own sensible lifetime. To rotate: move the current
# ENCRYPTION_KEY here, put a new one above, restart. Everything already written
# still decrypts; re-encrypt at leisure, then drop the retired key from this
# list. Removing it early is indistinguishable from losing the data.
ENCRYPTION_KEY_PREVIOUS=

# --- Backups --------------------------------------------------------------
# Generate with: openssl rand -base64 48
# MUST differ from ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS=30
