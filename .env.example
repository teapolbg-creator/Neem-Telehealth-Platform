# =============================================================================
# Neem — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
#
# The API validates this file with zod at boot. In production it REFUSES TO
# START if a required credential is missing, rather than silently degrading.
# In development, an absent provider credential selects the mock adapter and
# logs a prominent warning (spec §7, §77, §93).
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# The Lovable vite config pins the dev server to 8080 (it does its own port
# and strictPort handling). WEB_ORIGIN must match, or the API rejects the web
# app on CORS — the session travels as a cookie, so the origin must be exact.
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Must match docker/docker-compose.yml. Host port defaults to 3307 so it does
# not collide with a native MySQL already listening on 3306.
MYSQL_PORT=3307
MYSQL_DATABASE=neem
MYSQL_USER=neem
MYSQL_PASSWORD=neem_dev
MYSQL_ROOT_PASSWORD=neem_root_dev

DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem"
TEST_DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem_test"

# Prisma Migrate uses a throwaway shadow database to detect schema drift.
# Provided explicitly so the application user needs no CREATE DATABASE right.
SHADOW_DATABASE_URL="mysql://neem:neem_dev@localhost:3307/neem_shadow"

# Least-privilege append-only account for the audit log (docs/security.md §7).
AUDIT_DATABASE_URL="mysql://neem_audit:neem_audit_dev@localhost:3307/neem"

# --- Secrets ----------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The development placeholders below are NOT usable in production; the config
# loader rejects them when NODE_ENV=production.
SESSION_SECRET=dev-only-change-me-session-secret-value-0000000000
CSRF_SECRET=dev-only-change-me-csrf-secret-value-00000000000000

# AES-256-GCM key for encrypting patient name/phone, doctor signatures,
# pharmacy payout details and TOTP secrets at rest. 32 bytes, base64url.
ENCRYPTION_KEY=dev-only-change-me-encryption-key-000000000000

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
PATIENT_SESSION_TIMEOUT_MINUTES=60

# --- Authentication hardening ----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX_PER_MINUTE=120

# Stricter per-IP cap on login, 2FA and password-reset endpoints. Distinct from
# LOGIN_MAX_ATTEMPTS, which locks one account; this caps one source across many.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW="15 minutes"
RATE_LIMIT_ONBOARDING_MAX=5
RATE_LIMIT_ONBOARDING_WINDOW="1 hour"

# --- Providers --------------------------------------------------------------
# Each accepts: mock | <real provider>. Leave as mock until credentials exist.
# Mock mode is labelled in the UI and stamped on every log line — the system
# never claims a payment, call or message happened when it cannot verify it.
PAYMENT_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mailhog
WHATSAPP_PROVIDER=mock

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Notification senders. Required when the matching provider is set to twilio:
# Twilio rejects a message with no From, so a missing one would boot cleanly
# and then deliver nothing.
TWILIO_SMS_NUMBER=
# Without the whatsapp: prefix — the adapter adds it.
TWILIO_WHATSAPP_NUMBER=
TWILIO_TIMEOUT_MS=15000

# Paystack signs webhooks with the SECRET key. PAYSTACK_WEBHOOK_SECRET exists
# only to separate the two in a test harness; leave it unset in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Twilio — Video, Voice (Call Me), and optionally SMS.
# NOTE: verify the current status and roadmap of Twilio Programmable Video
# before Phase 5 — see docs/phase-0-findings.md C9.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VOICE_NUMBER=

# SMTP (MailHog by default in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Neem <no-reply@neem.local>"

# SMS / WhatsApp — provider not yet selected (spec §57). Build against the
# abstraction; fill these in once a Ghana-capable provider is chosen.
SMS_API_KEY=
SMS_SENDER_ID=Neem
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- File storage -----------------------------------------------------------
# Local disk in development; swap for object storage in the cloud without
# touching business logic. Stored OUTSIDE the web root, served only through an
# authorised, audited endpoint.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./apps/api/uploads
UPLOAD_MAX_BYTES=10485760

# --- Demo data --------------------------------------------------------------
# Seeds demo pharmacies, doctors, consultations and analytics, all flagged
# isDemo=true. MUST be false in production (spec §76).
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@neem.demo
DEMO_ADMIN_PASSWORD=NeemDemoAdmin!2026
# QR token exchange, per IP. A pharmacy shares one public IP, so this allows a
# real queue of patients while still stopping a script guessing tokens.
RATE_LIMIT_QR_EXCHANGE_MAX=20
RATE_LIMIT_QR_EXCHANGE_WINDOW="5 minutes"

# Retired encryption keys, comma-separated. Decrypt-only, never used to encrypt.
# Clinical records are retained for years (decision D23), so the key that wrote
# them outlives its own sensible lifetime. To rotate: move the current
# ENCRYPTION_KEY here, put a new one above, restart. Everything already written
# still decrypts; re-encrypt at leisure, then drop the retired key from this
# list. Removing it early is indistinguishable from losing the data.
ENCRYPTION_KEY_PREVIOUS=

# --- Backups --------------------------------------------------------------
# Generate with: openssl rand -base64 48
# MUST differ from ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS=30
